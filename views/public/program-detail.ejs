<%
  const cat = categoryBy(program.category);
  const initial = pricing[8];
  const loginNext = '/masuk?next=' + encodeURIComponent('/program/' + program.slug);
%>
<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<main>
  <section class="detail-hero tint-<%= cat.tint %>">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Beranda</a><span>/</span>
        <a href="/program">Program</a><span>/</span>
        <span><%= cat.label %></span>
      </nav>

      <div class="detail-hero-grid">
        <div class="detail-art">
          <span class="detail-art-chip"><%= cat.label %></span>
          <span class="detail-art-icon"><%- icon(cat.icon) %></span>
          <div class="detail-art-foot">
            <span><%- icon(program.mode === 'hybrid' ? 'map-pin' : 'video') %> <%= modeLabel(program.mode) %></span>
            <span><%- icon('clock') %> <%= program.duration %> menit / sesi</span>
          </div>
        </div>

        <div class="detail-intro">
          <span class="pill tint-<%= cat.tint %>"><%= cat.label %></span>
          <h1 class="display-2"><%= program.title %></h1>
          <p class="detail-lede"><%= program.description %></p>

          <div class="detail-meta-row">
            <span class="meta-chip"><%- icon('graduation') %> <%= program.level %></span>
            <span class="meta-chip"><%- icon('calendar') %> <%= program.duration %> menit / sesi</span>
            <span class="meta-chip"><%- icon('users') %> Kelas privat 1-on-1</span>
          </div>

          <div class="detail-tutor-row">
            <span class="avatar avatar-md accent-<%= program.tutor_accent || 'sage' %>"><%= initials(program.tutor_name || 'Tutor') %></span>
            <div>
              <span class="tiny-label">Dibimbing oleh</span>
              <strong><%= program.tutor_name || 'Tutor Kelompok 4' %></strong>
              <span class="tutor-sub"><%= program.tutor_title || program.tutor_expertise %></span>
            </div>
            <div class="detail-rating">
              <span class="rating"><%- icon('star') %> <%= Number(program.rating).toFixed(1) %></span>
              <span><%= formatNumber(program.students) %> siswa</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container detail-grid">
      <div class="detail-main">
        <article class="content-card">
          <h2>Tentang program ini</h2>
          <p><%= program.description %></p>
          <div class="info-grid">
            <div><span class="info-label">Kategori</span><strong><%= cat.label %></strong></div>
            <div><span class="info-label">Jenjang</span><strong><%= program.level %></strong></div>
            <div><span class="info-label">Mode belajar</span><strong><%= modeLabel(program.mode) %></strong></div>
            <div><span class="info-label">Durasi sesi</span><strong><%= program.duration %> menit</strong></div>
          </div>
        </article>

        <article class="content-card">
          <h2>Yang akan kamu pelajari</h2>
          <ul class="check-list">
            <% highlights.forEach(function(item) { %>
              <li><span class="check-icon"><%- icon('check') %></span><span><%= item %></span></li>
            <% }); %>
          </ul>
        </article>

        <article class="content-card tutor-profile">
          <div class="tutor-profile-head">
            <span class="tutor-avatar tutor-avatar-lg accent-<%= program.tutor_accent || 'sage' %>"><%= initials(program.tutor_name || 'Tutor') %></span>
            <div>
              <span class="tiny-label">Tutor program</span>
              <h2><%= program.tutor_name || 'Tutor Kelompok 4' %></h2>
              <p class="tutor-title"><%= program.tutor_title || program.tutor_expertise %></p>
            </div>
            <% if (program.tutor_badge) { %><span class="tutor-badge"><%= program.tutor_badge %></span><% } %>
          </div>
          <p><%= program.tutor_bio || 'Tutor berpengalaman Kelompok 4 yang siap mendampingi proses belajarmu.' %></p>
          <div class="tutor-profile-stats">
            <div><strong><%= Number(program.tutor_rating || 4.9).toFixed(1) %></strong><span>Rating tutor</span></div>
            <div><strong><%= formatNumber(program.tutor_students || 0) %></strong><span>Siswa terbimbing</span></div>
            <div><strong>1-on-1</strong><span>Format kelas</span></div>
          </div>
        </article>

        <article class="content-card">
          <h2>Cara belajar di Kelompok 4</h2>
          <div class="mini-steps">
            <div><span>01</span><p>Pemetaan kebutuhan dan target belajar pada sesi pertama.</p></div>
            <div><span>02</span><p>Materi disusun bertahap dengan latihan yang relevan.</p></div>
            <div><span>03</span><p>Evaluasi tiap sesi dan laporan progres setiap bulan.</p></div>
          </div>
        </article>
      </div>

      <aside class="booking-wrap" id="pesan">
        <div class="booking-card">
          <div class="booking-head">
            <div>
              <span class="tiny-label">Harga per sesi</span>
              <div class="price-xl"><%= formatRupiah(program.price) %><span>/sesi</span></div>
            </div>
            <span class="pill tint-sage"><%- icon('video') %> <%= modeLabel(program.mode) %></span>
          </div>

          <%- user
            ? '<form class="booking-form" method="post" action="/pesan" data-booking-form>'
            : '<div class="booking-form booking-static">' %>
            <% if (user) { %><input type="hidden" name="program_slug" value="<%= program.slug %>"><% } %>

            <div class="field-group">
              <span class="field-label">Pilih paket sesi</span>
              <div class="package-list">
                <% packages.forEach(function(pkg) { const pr = pricing[pkg.sessions]; %>
                  <label class="package-option <%= pkg.popular ? 'is-popular' : '' %>">
                    <input type="radio" name="sessions" value="<%= pkg.sessions %>"
                      data-subtotal="<%= pr.subtotal %>" data-discount="<%= pr.discount %>"
                      data-fee="<%= pr.fee %>" data-total="<%= pr.total %>"
                      <%= pkg.sessions === 8 ? 'checked' : '' %>>
                    <span class="package-radio" aria-hidden="true"></span>
                    <span class="package-main">
                      <span class="package-title"><%= pkg.sessions %> sesi
                        <% if (pkg.popular) { %><span class="package-tag">Favorit</span><% } %>
                      </span>
                      <span class="package-note"><%= pkg.note %></span>
                    </span>
                    <span class="package-price">
                      <strong><%= formatRupiah(pr.total) %></strong>
                      <% if (pr.discount > 0) { %><span class="package-discount">Hemat <%= formatRupiah(pr.discount) %></span><% } %>
                    </span>
                  </label>
                <% }); %>
              </div>
            </div>

            <div class="field-row two">
              <label class="field">
                <span>Tanggal mulai</span>
                <input type="date" name="start_date" min="<%= minBookingDate %>" value="<%= minBookingDate %>" required>
              </label>
              <label class="field">
                <span>Jam belajar</span>
                <select name="time_slot" required>
                  <% timeSlots.forEach(function(slot, index) { %>
                    <option value="<%= slot %>" <%= index === 3 ? 'selected' : '' %>><%= slot %> WIB</option>
                  <% }); %>
                </select>
              </label>
            </div>

            <label class="field">
              <span>Catatan untuk tutor <small>(opsional)</small></span>
              <textarea name="notes" rows="3" maxlength="500" placeholder="Contoh: ingin fokus pada persiapan ulangan minggu depan."></textarea>
            </label>

            <div class="booking-summary" data-booking-summary>
              <div><span>Subtotal</span><strong data-sum-subtotal><%= formatRupiah(initial.subtotal) %></strong></div>
              <div data-discount-row><span>Diskon paket</span><strong data-sum-discount><%= initial.discount ? '- ' + formatRupiah(initial.discount) : '—' %></strong></div>
              <div><span>Biaya layanan</span><strong data-sum-fee><%= formatRupiah(initial.fee) %></strong></div>
              <div class="summary-total"><span>Total</span><strong data-sum-total><%= formatRupiah(initial.total) %></strong></div>
            </div>

            <% if (user) { %>
              <button class="btn btn-primary btn-block btn-lg" type="submit">Lanjut ke pembayaran <%- icon('arrow-right') %></button>
              <p class="form-note">Pesanan akan dibuat dan kamu diarahkan ke halaman pembayaran.</p>
            <% } else { %>
              <a class="btn btn-primary btn-block btn-lg" href="<%= loginNext %>">Masuk untuk memesan <%- icon('arrow-right') %></a>
              <p class="form-note">Belum punya akun? <a href="/daftar?next=<%= encodeURIComponent('/program/' + program.slug) %>">Daftar gratis</a>.</p>
            <% } %>

            <ul class="trust-list">
              <li><%- icon('shield') %> Pembayaran aman & invoice resmi</li>
              <li><%- icon('refresh') %> Jadwal bisa diubah H-1</li>
              <li><%- icon('users') %> Garansi ganti tutor 2 sesi pertama</li>
            </ul>
          <%- user ? '</form>' : '</div>' %>
        </div>

        <div class="booking-help">
          <span><%- icon('message') %></span>
          <div>
            <strong>Butuh bantuan memilih paket?</strong>
            <a href="mailto:<%= app.email %>?subject=Tanya%20program%20<%= encodeURIComponent(program.title) %>">Chat tim Kelompok 4 <%- icon('arrow-right') %></a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <% if (related.length) { %>
    <section class="section section-tint">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">Lanjutkan eksplorasi</p>
            <h2 class="display-2">Program lain di <em><%= cat.label %></em>.</h2>
          </div>
          <a class="text-link" href="/program?kategori=<%= cat.slug %>">Lihat kategori <%- icon('arrow-right') %></a>
        </div>
        <div class="program-grid">
          <% related.forEach(function(program) { %>
            <%- include('../partials/program-card', { program: program }) %>
          <% }); %>
        </div>
      </div>
    </section>
  <% } %>
</main>

<script src="/js/booking.js"></script>
<%- include('../partials/footer') %>
</body>
</html>
