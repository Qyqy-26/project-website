<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="brand brand-light" href="/">
        <span class="brand-mark">4</span>
        <span class="brand-word">Kelompok 4</span>
      </a>
      <p class="footer-tagline">Les privat dan kursus online yang dirancang personal untuk setiap cara belajar.</p>
      <div class="footer-contact">
        <a href="mailto:<%= app.email %>"><%- icon('mail') %> <%= app.email %></a>
        <a href="tel:085813089193"><%- icon('phone') %> <%= app.phone %></a>
        <span><%- icon('map-pin') %> <%= app.address %></span>
      </div>
    </div>

    <div class="footer-col">
      <p class="footer-title">Program</p>
      <% categories.forEach(function(cat) { %>
        <a href="/program?kategori=<%= cat.slug %>"><%= cat.label %></a>
      <% }); %>
    </div>

    <div class="footer-col">
      <p class="footer-title">Kelompok 4</p>
      <a href="/program">Katalog program</a>
      <a href="/tutor">Tutor kami</a>
      <a href="/#cara-kerja">Cara kerja</a>
      <a href="/#faq">Pertanyaan umum</a>
    </div>

    <div class="footer-col">
      <p class="footer-title">Bantuan</p>
      <a href="/masuk">Masuk akun</a>
      <a href="/daftar">Daftar akun</a>
      <a href="mailto:<%= app.email %>">Hubungi kami</a>
      <a href="/#faq">Kebijakan pembayaran</a>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© <%= currentYear %> Kelompok 4 Private Tutor. Semua hak dilindungi.</p>
    <div class="pay-chips" aria-label="Metode pembayaran">
      <span>BCA</span><span>Mandiri</span><span>QRIS</span><span>GoPay</span>
    </div>
  </div>
</footer>
<script src="/js/main.js"></script>
