<header class="site-header" data-header>
  <div class="container nav-inner">
    <a class="brand" href="/" aria-label="Kelompok 4 — beranda">
      <span class="brand-mark">4</span>
      <span class="brand-word">Kelompok 4</span>
    </a>

    <nav class="nav-links" aria-label="Navigasi utama">
      <a href="/program" class="<%= reqPath.startsWith('/program') ? 'is-active' : '' %>">Program</a>
      <a href="/tutor" class="<%= reqPath === '/tutor' ? 'is-active' : '' %>">Tutor</a>
      <a href="/#cara-kerja">Cara kerja</a>
      <a href="/#faq">FAQ</a>
    </nav>

    <div class="nav-actions">
      <% if (user) { %>
        <a class="nav-user" href="<%= user.role === 'admin' ? '/admin' : '/dashboard' %>">
          <span class="avatar avatar-sm avatar-<%= user.role === 'admin' ? 'forest' : 'amber' %>"><%= initials(user.name) %></span>
          <span class="nav-user-name"><%= user.name.split(' ')[0] %></span>
        </a>
        <a class="btn btn-primary btn-sm" href="<%= user.role === 'admin' ? '/admin' : '/dashboard' %>">
          <%= user.role === 'admin' ? 'Panel Admin' : 'Dashboard' %>
        </a>
      <% } else { %>
        <a class="nav-login" href="/masuk">Masuk</a>
        <a class="btn btn-primary btn-sm" href="/daftar">Daftar gratis</a>
      <% } %>
    </div>

    <button class="nav-toggle" type="button" data-menu-toggle aria-label="Buka menu" aria-expanded="false">
      <%- icon('menu') %>
    </button>
  </div>

  <div class="mobile-menu" data-mobile-menu>
    <nav class="mobile-links">
      <a href="/program">Katalog program</a>
      <a href="/tutor">Tutor kami</a>
      <a href="/#cara-kerja">Cara kerja</a>
      <a href="/#faq">FAQ</a>
    </nav>
    <div class="mobile-actions">
      <% if (user) { %>
        <a class="btn btn-primary" href="<%= user.role === 'admin' ? '/admin' : '/dashboard' %>">
          <%= user.role === 'admin' ? 'Buka panel admin' : 'Buka dashboard' %>
        </a>
        <form action="/keluar" method="post"><button class="btn btn-outline" type="submit">Keluar</button></form>
      <% } else { %>
        <a class="btn btn-primary" href="/daftar">Daftar gratis</a>
        <a class="btn btn-outline" href="/masuk">Masuk</a>
      <% } %>
    </div>
  </div>
</header>
