<%- include('../partials/head') %>

<main class="error-page error-page-standalone">
  <div class="container">
    <div class="error-card">
      <a class="brand brand-center" href="/">
        <span class="brand-mark">4</span>
        <span class="brand-word">Kelompok 4</span>
      </a>
      <span class="error-code">500</span>
      <p class="eyebrow">Terjadi kesalahan</p>
      <h1 class="display-2">Ada yang tidak berjalan semestinya.</h1>
      <p class="error-lede">Sistem kami mengalami kendala saat memproses permintaan ini. Coba muat ulang halaman, atau kembali beberapa saat lagi.</p>
      <div class="error-actions">
        <a class="btn btn-primary" href="/"><%- icon('home') %> Kembali ke beranda</a>
        <a class="btn btn-outline" href="javascript:history.back()">Muat ulang halaman</a>
      </div>
      <p class="error-help">Jika masalah berlanjut, hubungi <a href="mailto:<%= app.email %>"><%= app.email %></a>.</p>
    </div>
  </div>
</main>

</body>
</html>
